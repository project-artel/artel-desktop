# Pinned versions of everything the runtime bundle downloads. build.sh sources this file.
# Raising a version here is the whole upgrade; each value is checked against a checksum
# before it is unpacked.

# PostgreSQL 16 from theseus-rs/postgresql-binaries. The release tag is
# <postgres major>.<postgres minor>.<packaging release>; every asset has a .sha256 next to it.
PG_RELEASE=16.15.1

# pgvector source from the GitHub tag archive. pgvector publishes no checksum, so the
# digest below was taken once from the archive and pinned here.
PGVECTOR_VERSION=0.8.7
PGVECTOR_SHA256=cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85

# Eclipse Temurin JDK 21 from adoptium/temurin21-binaries. Each asset has a .sha256.txt.
# The JDK is only used to run jlink; the bundle ships the jlink output.
JAVA_RELEASE=21.0.12.1+1

# CPython 3.12 from astral-sh/python-build-standalone. The release carries one SHA256SUMS
# file for all of its assets. install_only_stripped is install_only without debug symbols:
# libpython alone drops from 114 MB to about 30 MB on linux-x64.
PYTHON_VERSION=3.12.15
PBS_RELEASE=20261013
PBS_FLAVOUR=install_only_stripped

# Modules added to what jdeps reports for the orchestration jar. jdeps does not see
# classes loaded by name: the EC and TLS providers, sun.misc.Unsafe users (Netty,
# Kotlin coroutines), JNDI DNS lookups, and the zip file system Spring Boot's
# nested jar loader can use.
JAVA_EXTRA_MODULES=jdk.crypto.ec,jdk.unsupported,jdk.naming.dns,jdk.zipfs,jdk.localedata,jdk.charsets
